#include <windows.h>
#include "../../MasterSim/src/MSIM_Version.h"

IDI_ICON1		ICON		DISCARDABLE	"gfx/MasterSimulator.ico"

// version numbers are defined in MasterSim/src/MSIM_Version.h
VS_VERSION_INFO VERSIONINFO
 FILEVERSION MSIM_VERSION_MAJOR,MSIM_VERSION_MINOR,MSIM_VERSION_PATCH,0
 PRODUCTVERSION MSIM_VERSION_MAJOR,MSIM_VERSION_MINOR,MSIM_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "Bauklimatik Dresden Software GmbH"
			VALUE "FileDescription", "MasterSim - FMI Co-Simulation Master"
			VALUE "FileVersion", MSIM_LONG_VERSION_STR
			VALUE "InternalName", "mastersim-gui"
			VALUE "LegalCopyright", "Copyright (c) 2017-today, Andreas Nicolai, BSD 3-Clause License"
			VALUE "OriginalFilename", "mastersim-gui.exe"
			VALUE "ProductName", "MasterSim"
			VALUE "ProductVersion", MSIM_LONG_VERSION_STR
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
