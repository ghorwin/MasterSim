# Room + Radiator co-simulation test case with input derivatives passed by the master.
#
# Baseline without input interpolation for comparison with Room_Radiator_MasterDeriv_GaussSeidel_1iters_Richardson.
# Error control with step-doubling (Richardson) and step size adjustment, hMax = 60 s.
#
# Both FMUs use inputInterpolationMode = 0 (zero-order hold).
# Common settings of the MasterDeriv test cases: tEnd = 14400 s, hStart = 5 s
# (stable range, K_p h / C = 0.2; with h = 30 s the predictive Radiator controller
# oscillates, see doc/algorithm/CoSim_InterpolatingOutputs.md). Reference solution:
# Room_Radiator_MasterDeriv_Reference.msim.

tStart                           0 s
tEnd                             14400 s
hMax                             60 s
hMin                             1e-05 s
hFallBackLimit                   0.01 s
hStart                           5 s
hOutputMin                       0.1 s
outputTimeUnit                   s
adjustStepSize                   yes
preventOversteppingOfEndTime     yes
absTol                           1e-06
relTol                           1e-05
MasterMode                       GAUSS_SEIDEL
ErrorControlMode                 STEP_DOUBLING
maxIterations                    1
writeInternalVariables           no
writeUnconnectedFileReaderVars   no

simulator 0 0 Radiator #ff447cb4 "fmus/IBK/Radiator.fmu"
simulator 1 1 Room #ffc38200 "fmus/IBK/Room.fmu"

graph Room.roomTemperature Radiator.roomTemperature
graph Radiator.heatingLoad Room.heatingLoad

parameter Radiator.inputInterpolationMode   0
parameter Room.inputInterpolationMode   0
