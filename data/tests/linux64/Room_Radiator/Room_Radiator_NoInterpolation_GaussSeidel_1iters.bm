<?xml version="1.0" encoding="UTF-8"?>
<BlockMod>
	<!--Blocks-->
	<Blocks>
		<Block name="Radiator">
			<Position>0, 0</Position>
			<Size>96, 128</Size>
			<!--Sockets-->
			<Sockets>
				<Socket name="roomTemperature">
					<Position>0, 16</Position>
					<Orientation>Horizontal</Orientation>
					<Inlet>true</Inlet>
				</Socket>
				<Socket name="heatingLoad">
					<Position>96, 16</Position>
					<Orientation>Horizontal</Orientation>
					<Inlet>false</Inlet>
				</Socket>
			</Sockets>
		</Block>
		<Block name="Room">
			<Position>0, 160</Position>
			<Size>96, 128</Size>
			<!--Sockets-->
			<Sockets>
				<Socket name="heatingLoad">
					<Position>0, 16</Position>
					<Orientation>Horizontal</Orientation>
					<Inlet>true</Inlet>
				</Socket>
				<Socket name="ambientTemperature">
					<Position>0, 32</Position>
					<Orientation>Horizontal</Orientation>
					<Inlet>true</Inlet>
				</Socket>
				<Socket name="roomTemperature">
					<Position>96, 16</Position>
					<Orientation>Horizontal</Orientation>
					<Inlet>false</Inlet>
				</Socket>
			</Sockets>
		</Block>
	</Blocks>
	<!--Connectors-->
	<Connectors>
		<Connector name="auto-named">
			<Source>Room.roomTemperature</Source>
			<Target>Radiator.roomTemperature</Target>
			<!--Connector segments (between start and end lines)-->
			<Segments>
				<Segment>
					<Orientation>Vertical</Orientation>
					<Offset>-160</Offset>
				</Segment>
				<Segment>
					<Orientation>Horizontal</Orientation>
					<Offset>-160</Offset>
				</Segment>
			</Segments>
		</Connector>
		<Connector name="auto-named">
			<Source>Radiator.heatingLoad</Source>
			<Target>Room.heatingLoad</Target>
			<!--Connector segments (between start and end lines)-->
			<Segments>
				<Segment>
					<Orientation>Horizontal</Orientation>
					<Offset>-272</Offset>
				</Segment>
				<Segment>
					<Orientation>Vertical</Orientation>
					<Offset>160</Offset>
				</Segment>
				<Segment>
					<Orientation>Horizontal</Orientation>
					<Offset>112</Offset>
				</Segment>
				<Segment>
					<Orientation>Vertical</Orientation>
					<Offset>0</Offset>
				</Segment>
			</Segments>
		</Connector>
	</Connectors>
</BlockMod>
