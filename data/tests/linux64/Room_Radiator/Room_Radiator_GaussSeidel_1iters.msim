# Created:	Sat Nov 21 13:34:30 2026
# LastModified:	Sat Nov 21 13:36:01 2026

# Room + Radiator co-simulation test case.
# 
# Demonstrates the effect of FMI 2.0 input/output interpolation:
# - the Room FMU integrates its ODE exactly for a linearly interpolated
#   heating load profile (canInterpolateInputs="true"),
# - the Radiator FMU extrapolates the room temperature from its input
#   history to anticipate the heating load (canInterpolateInputs="true"),
# - both FMUs provide output derivatives (maxOutputDerivativeOrder="1").
# 
# Gauss-Seidel with one iteration, fixed time step of 60 s, one full
# day/night cycle (12 h at 22 degC, 12 h at 16 degC).

tStart                           0 s
tEnd                             28800 s
hMax                             30 min
hMin                             1e-05 s
hFallBackLimit                   0.01 s
hStart                           30 s
hOutputMin                       0.1 s
outputTimeUnit                   s
adjustStepSize                   no
preventOversteppingOfEndTime     yes
absTol                           1e-06
relTol                           1e-05
MasterMode                       GAUSS_SEIDEL
ErrorControlMode                 NONE
maxIterations                    1
writeInternalVariables           no
writeUnconnectedFileReaderVars   no

simulator 0 0 Radiator #447cb4 "fmus/IBK/Radiator.fmu"
simulator 1 1 Room #c38200 "fmus/IBK/Room.fmu"

graph Room.roomTemperature Radiator.roomTemperature
graph Radiator.heatingLoad Room.heatingLoad

