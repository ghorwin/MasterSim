# Room + Radiator reference test case.
#
# Same model as the other test cases, but with a small fixed time step of
# 5 s. The results serve as reference to quantify the accuracy loss of
# the coarse 60 s stepping (with and without interpolation).

tStart               0 s
tEnd                 14400 s
hMax                 30 min
hMin                 1e-05 s
hFallBackLimit       0.01 s
hStart               5 s
hOutputMin           0.1 s
adjustStepSize       no
absTol               1e-06
relTol               1e-05
MasterMode           GAUSS_SEIDEL
ErrorControlMode     NONE
maxIterations        1

simulator 0 0 Radiator #ff447cb4 "fmus/IBK/Radiator.fmu"
simulator 1 1 Room #ffc38200 "fmus/IBK/Room.fmu"

graph Room.roomTemperature Radiator.roomTemperature
graph Radiator.heatingLoad Room.heatingLoad
