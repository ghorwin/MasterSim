#!/usr/bin/make -f
# output every command that modifies files on the build system.
#export DH_VERBOSE = 1

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Selects the Debian-specific resource/translation paths in the GUI
# (see MasterSimulatorUI/src/MSIMDirectories.cpp). CMake ignores CPPFLAGS,
# hence the define is appended to CXXFLAGS.
export DEB_CXXFLAGS_MAINT_APPEND = -DIBK_BUILDING_DEBIAN_PACKAGE

%:
	dh $@

# MasterSim has no ctest-based tests; the regression suite needs the
# full test data set, which is not part of the source package.
override_dh_auto_test:
