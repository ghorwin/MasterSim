############################################
#
# Global Options (Should be written by some external script and not be commited!)
# This Options File is a ONE of many selection,
# There should never be more then one option defined!!!
#
############################################

# This option enables extensive runtime checks.
#OPTIONS += sanitize_checks

#
# By default, binaries/DLLs are created in <repo-root>/bin/debug or
# <repo-root>/bin/release, while the libraries are created in the 'lib'
# subdirectory of the current shadow build directory.
# This option places the binaries/DLLs in the 'bin/debug' or 'bin/release'
# subdirectory of the shadow build directory as well, so that nothing is
# written into the source tree at all.
#
#OPTIONS += binaries_to_shadow_dir

#
# This option enables open mp support in compiler.
#
#OPTIONS += openmp

#
# This option enables gprof support in compiler.
#
#OPTIONS += gprof
